# Google Maps JavaScript API Key (Optional: for Google Street, Satellite, and Terrain basemaps)
# Obtain from: https://console.cloud.google.com/google/maps-apis/credentials
# Ensure the key is restricted by HTTP referrer to your domain/localhost
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend FastAPI URL
VITE_API_URL=http://127.0.0.1:8000
