# =========================================================================
# EARTH INTELLIGENCE DIGITAL TWIN (EIDT) - MUMBAI METROPOLITAN REGION
# Environment Configuration & API Credentials Template
# Copy this file to .env and configure keys as needed.
# Note: The platform operates in robust fallback mode when external credentials
# are absent, adhering to the "no fabricated live data" mandate.
# =========================================================================

# Database Configuration (PostgreSQL with PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=eidt_mumbai
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/eidt_mumbai

# 1. Copernicus Data Space Ecosystem (CDSE) - Sentinel-1 SAR & Sentinel-2 Optical
# Optional connector: Registration currently paused. Disabled by default.
ENABLE_CDSE_INTEGRATION=false
CDSE_CLIENT_ID=your_cdse_client_id_optional
CDSE_CLIENT_SECRET=your_cdse_client_secret_optional

# 2. NASA Earthdata Login - GPM IMERG Precipitation
# Register at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# 3. OpenTopography API - High-Resolution Copernicus DEM 30m / SRTM
# Register at: https://portal.opentopography.org/
OPEN_TOPO_API_KEY=your_opentopography_key_optional

# 4. OpenStreetMap Overpass API
# Default public interpreter: https://overpass-api.de/api/interpreter
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# 5. India Meteorological Department (IMD) AWS Access
# Registration: https://mausam.imd.gov.in/
IMD_API_KEY=your_imd_moes_api_key_optional

# 6. Google Cloud Platform (Google Maps Platform)
# Maps JavaScript API & Tiles
# Obtain from: https://console.cloud.google.com/google/maps-apis/credentials
# Security Requirement: Restrict key in Google Cloud Console:
#   1. Application restrictions -> Set HTTP referrers (e.g., http://localhost:5173/*, http://127.0.0.1:5173/*)
#   2. API restrictions -> Restrict key to "Maps JavaScript API" only
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Operational & Deployment Settings (Phase 7G)
ENVIRONMENT=production
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000
ALLOW_DEMO_FALLBACK=true
REQUEST_TIMEOUT_SECONDS=25
MAX_RETRIES=3
